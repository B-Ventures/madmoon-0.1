rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = authenticated Firebase user carrying the "admin" custom claim.
    // Custom claims are granted out-of-band via the createAdminUser Cloud
    // Function (see functions/index.js) or the functions/scripts/grantInitialAdmin.js
    // bootstrap script — NOT simply by having a Firebase Auth account.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // A freshly submitted / re-submitted merchant record must always start
    // out unverified. Prevents a caller from self-issuing a verified badge
    // on creation.
    function isUnverifiedSubmission() {
      return request.resource.data.verificationStatus == 'pending'
        && request.resource.data.domainVerified == false
        && request.resource.data.crVerified == false;
    }

    // Public click tracking is only allowed to touch clickCount, and only
    // to increment it by exactly one at a time.
    function isClickCountIncrement() {
      let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
      return diffKeys.hasOnly(['clickCount'])
        && request.resource.data.clickCount == resource.data.clickCount + 1;
    }

    // Merchants Collection Rules
    match /merchants/{storeSlug} {
      // Public can read store details to render badge & certificate
      allow read: if true;

      // Anyone can register a new store, but it always lands as 'pending'
      // until an admin reviews it. Admins may also write pre-verified
      // records directly (e.g. seeding/import).
      allow create: if isAdmin() || isUnverifiedSubmission();

      // Public may only bump the click counter. Approving, rejecting, or
      // changing verification/tier fields requires an admin.
      allow update: if isAdmin() || isClickCountIncrement();

      // Only authenticated admin can delete merchant records
      allow delete: if isAdmin();
    }

    // Buyer Dispute Reports Collection Rules
    match /reports/{reportId} {
      // Anyone can submit a dispute report, always starting as 'pending'.
      allow create: if isAdmin() || request.resource.data.status == 'pending';

      // Public read / admin management
      allow read: if true;

      // Only admin resolves/updates report status
      allow update: if isAdmin();

      // Delete reports
      allow delete: if isAdmin();
    }

    match /disputes/{disputeId} {
      allow create: if isAdmin() || request.resource.data.status == 'pending';
      allow read: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
